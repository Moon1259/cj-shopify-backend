# Render FREE tier, store catmpp-jq.myshopify.com, CJ free tier. Paste into Render > Environment.
SHOPIFY_STORE=catmpp-jq.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=
CJ_API_KEY=
GITHUB_TOKEN=
GITHUB_REPO=moon1259/industrial-pantry-products
GITHUB_BRANCH=data
CRON_SECRET=

FILTER_VERSION=v3
PRODUCT_STATUS=draft          # review in Shopify for the first days, then set to active

DAILY_POINTS=250
ORDER_RESERVE=50
POINTS_PER_CALL=20
POINTS_PER_PRODUCT=20         # estimate mode = one detail call per product = 20 points
MAX_PER_RUN=10
TIME_BUDGET=240
FREIGHT_MODE=estimate
STOCK_LOOKUP=false
AUTO_CALIBRATE=true
PROFIT=1.3
