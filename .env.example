# ---- secrets (set in Render > Environment, never commit) ----
CJ_API_KEY=
SHOPIFY_STORE=factory-essentials-2.myshopify.com
SHOPIFY_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=moon1259/industrial-pantry-products
GITHUB_BRANCH=data
CRON_SECRET=
SHOPIFY_API_VERSION=2026-07

# ---- pricing ----
PROFIT=1.3                  # price = (CJ price + shipping) * 1.3, rounded to .99
DEST_COUNTRY=US

# ---- CJ points budget (START HERE, then raise only if the logs show no "points exhausted") ----
DAILY_POINTS=250            # your observed real limit is ~200-300; keep it conservative
ORDER_RESERVE=50            # points sync may never touch, so customer orders still reach CJ
POINTS_PER_CALL=10          # cost of one CJ API call
POINTS_PER_PRODUCT=20       # exact freight = detail + freight calls. Use 10 together with FREIGHT_MODE=estimate
AUTO_CALIBRATE=1            # when CJ says "Insufficient API points", remember the real limit
FREIGHT_MODE=exact          # set to "estimate" to halve points per product (weight-based shipping guess)
STOCK_LOOKUP=0              # 1 = extra call per product for real stock (otherwise qty 100 + "In Stock")
PAGE_SIZE=50                # more candidates per 10-point list call; drop to 20 if CJ rejects it
MAX_PAGES_PER_TERM=3        # do not dig deep into one keyword
MAX_PER_RUN=40              # upper cap only; the points budget stops the run first
TIME_BUDGET=600             # seconds

# ---- collections ----
AUTO_CREATE_COLLECTIONS=1   # create missing smart collections (rule: Product type = category)
FIX_SMART_RULES=1           # force your smart collections to use that rule

# ---- optional: crawl whole CJ categories instead of keywords (ids from `maintenance.py cj-categories`) ----
CJ_CATEGORY_IDS=

AUTO_PAY_CJ=0

# ---- Shopify auth for Dev Dashboard apps (no shpat_ token exists) ----
SHOPIFY_CLIENT_ID=          # Dev Dashboard > your app > Settings > Credentials
SHOPIFY_CLIENT_SECRET=      # same page. Also used to verify app webhooks (set SHOPIFY_WEBHOOK_SECRET to the same value)
SHOPIFY_API_VERSION=2026-07 # any supported version; 2026-10 also fine
# SHOPIFY_TOKEN=            # leave EMPTY (old shpat_ value would shadow nothing, but remove it)
